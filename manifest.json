{
  "manifest_version": 3,
  "name": "待读 · Bookmark Inbox",
  "version": "1.0.0",
  "description": "把书签栏中尚未归档的网页，变成新标签页上的阅读清单。",
  "permissions": ["bookmarks", "favicon", "storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
